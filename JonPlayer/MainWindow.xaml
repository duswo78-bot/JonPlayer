                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="`" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="1" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2"><TextBlock Text="2" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="창 크기 50% / 100% / 200% (Window Size 50/100/200%)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="&lt;" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2"><TextBlock Text="&gt;" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="재생 속도 감소 / 증가 (Speed Down / Up)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="←" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2"><TextBlock Text="→" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="5초 탐색 (Ctrl: 30s Jump)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="↑" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2"><TextBlock Text="↓" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="볼륨 조절 / 플레이리스트 이동 (Volume / Playlist Nav)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="M" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="음소거 설정/해제 (Toggle Mute)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="F9" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2"><TextBlock Text="Ctrl+L" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="플레이리스트 토글 (Toggle Playlist)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="F3" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="통계 표시 (Toggle Stats)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="Ctrl+O" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="파일 열기 (Open File)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="Ctrl+Shift+O" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="폴더 열기 (Open Folder)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="C" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="화면 캡처 (Screenshot to Downloads)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="Ctrl+W" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="파일 닫기 (Close File)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <Button x:Name="NextVideoOverlay" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,90" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10" Cursor="Hand" Click="NextVideoOverlay_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Move to Next" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" Background="#44FFFFFF" CornerRadius="4" Margin="0,0,8,0">
                            <Path Data="{StaticResource PlayIcon}" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                        </Border>
                        <TextBlock x:Name="TxtNextVideoName" Text="Video Name.mp4" Foreground="White" FontSize="13" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Popup x:Name="PopupFsExit" PlacementTarget="{Binding ElementName=VideoGrid}" Placement="Top" AllowsTransparency="True" StaysOpen="True">
                <Border x:Name="FsExitBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Background="#CC000000" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14,6" MouseEnter="FsExitBadge_MouseEnter" MouseLeave="FsExitBadge_MouseLeave">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="창 모드로 돌아가기" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="✕" Width="22" Height="22" FontSize="11" Foreground="White" Background="#44FFFFFF" BorderThickness="0" Cursor="Hand" Focusable="False" Click="BtnExitFullscreen_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#88FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Grid x:Name="FsBottomStrip" HorizontalAlignment="Stretch" MaxWidth="960" MinWidth="750" VerticalAlignment="Bottom" Margin="0,0,0,20" MouseEnter="FsBottomStrip_MouseEnter" MouseLeave="FsBottomStrip_MouseLeave" Visibility="Collapsed">
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Opacity="0.7"/>
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="16" Padding="24,12">
                    <StackPanel Orientation="Vertical">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCurrentTimeFS" Grid.Column="0" Text="00:00:00" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SliderTimelineFS" Grid.Column="1" Style="{StaticResource TimelineSlider}" Minimum="0" Maximum="1000" Value="0" IsEnabled="False" IsMoveToPointEnabled="True" Thumb.DragStarted="SliderTimeline_DragStarted" Thumb.DragCompleted="SliderTimeline_DragCompleted" ValueChanged="SliderTimeline_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalTimeFS" Grid.Column="2" Text="00:00:00" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Style="{StaticResource KnobButton}" ToolTip="Open File (Ctrl+O)" Click="BtnOpen_Click" Margin="0,0,8,0">
                                <Path Data="{StaticResource OpenIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnPlaylistToggleFS" Style="{StaticResource KnobButton}" ToolTip="Playlist (F9)" Click="BtnPlaylistToggle_Click" IsEnabled="False" Margin="0,0,8,0">
                                <Path Data="{StaticResource PlaylistIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnRepeatFS" Style="{StaticResource TextToggleButton}" Content="REPEAT" Click="BtnRepeat_Click" Margin="0,0,8,0" ToolTip="Repeat Playlist"/>
                            <Button x:Name="BtnShuffleFS" Style="{StaticResource TextToggleButton}" Content="SHUFFLE" Click="BtnShuffle_Click" Margin="0,0,8,0" ToolTip="Shuffle Playlist"/>
                            <Button x:Name="BtnWhisperFS" Style="{StaticResource TextToggleButton}" Content="CC+" Click="BtnWhisper_Click" Margin="4,0,8,0" ToolTip="Auto Generate Subtitle (Whisper)" Height="20" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5" CornerRadius="4" Padding="6,0" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="On">
                                                <Setter Property="Foreground" Value="#00E5FF"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="TxtWhisperProgressFS" Text="" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource KnobButton}" ToolTip="Previous" Click="BtnPrev_Click" Margin="0,0,6,0">
                                <Path Data="{StaticResource PrevIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource KnobButton}" ToolTip="Rewind 10s" Click="BtnSkipBack_Click" Margin="0,0,6,0">
                                <Path Data="{StaticResource RewindIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button x:Name="BtnPlayPauseFS" Style="{StaticResource KnobButton}" Width="44" Height="44" ToolTip="Play/Pause" Click="BtnPlayPause_Click" Margin="0,0,6,0">
                                <Path x:Name="PlayPauseIconPathFS" Data="{StaticResource PlayIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource KnobButton}" ToolTip="Stop" Click="BtnStop_Click" Margin="0,0,6,0">
                                <Path Data="{StaticResource StopIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource KnobButton}" ToolTip="Forward 10s" Click="BtnSkipForward_Click" Margin="0,0,6,0">
                                <Path Data="{StaticResource ForwardIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource KnobButton}" ToolTip="Next" Click="BtnNext_Click">
                                <Path Data="{StaticResource NextIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnMuteFS" Style="{StaticResource KnobButton}" ToolTip="Mute (M)" Click="BtnMute_Click" Margin="0,0,5,0">
                                <Path x:Name="MuteIconPathFS" Data="{StaticResource VolumeHighIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Slider x:Name="SliderVolumeFS" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True" ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnSpeedFS" Style="{StaticResource SpeedTextButton}" Content="1.0x ▾" ToolTip="Speed" Click="BtnSpeed_Click" Margin="0,0,12,0">
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MenuSpeedFS">
                                        <MenuItem Header="0.25x" Tag="0.25" Click="MenuItemSpeed_Click"/>
                                        <MenuItem Header="0.5x"  Tag="0.5"  Click="MenuItemSpeed_Click"/>
                                        <MenuItem Header="0.75x" Tag="0.75" Click="MenuItemSpeed_Click"/>
                                        <MenuItem Header="1.0x"  Tag="1.0"  Click="MenuItemSpeed_Click"/>
                                        <MenuItem Header="1.25x" Tag="1.25" Click="MenuItemSpeed_Click"/>
                                        <MenuItem Header="1.5x"  Tag="1.5"  Click="MenuItemSpeed_Click"/>
                                        <MenuItem Header="2.0x"  Tag="2.0"  Click="MenuItemSpeed_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="BtnThemeFS" Style="{StaticResource KnobButton}" ToolTip="Toggle Theme" Click="BtnTheme_Click" Margin="0,0,5,0">
                                <Path x:Name="ThemeIconPathFS" Data="{StaticResource MoonIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource KnobButton}" ToolTip="Exit Fullscreen (Esc)" Click="BtnExitFullscreen_Click">
                                <Path Data="{StaticResource ExitFullscreenIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>

        <Border Grid.Row="2" x:Name="TimelineBar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtCurrentTime" Grid.Column="0" Text="00:00:00" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <Slider x:Name="SliderTimeline" Grid.Column="1" Style="{StaticResource TimelineSlider}" Minimum="0" Maximum="1000" Value="0" IsEnabled="False" IsMoveToPointEnabled="True" Thumb.DragStarted="SliderTimeline_DragStarted" Thumb.DragCompleted="SliderTimeline_DragCompleted" ValueChanged="SliderTimeline_ValueChanged" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="00:00:00" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,14,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" x:Name="ControlBar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource KnobButton}" ToolTip="Open File (Ctrl+O)" Click="BtnOpen_Click" Margin="0,0,8,0">
                        <Path Data="{StaticResource OpenIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnPlaylistToggle" Style="{StaticResource KnobButton}" ToolTip="Playlist (F9)" Click="BtnPlaylistToggle_Click" IsEnabled="False" Margin="0,0,8,0">
                        <Path Data="{StaticResource PlaylistIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnRepeat" Style="{StaticResource TextToggleButton}" Content="REPEAT" Click="BtnRepeat_Click" Margin="0,0,8,0" ToolTip="Repeat Playlist"/>
                    <Button x:Name="BtnShuffle" Style="{StaticResource TextToggleButton}" Content="SHUFFLE" Click="BtnShuffle_Click" Margin="0,0,8,0" ToolTip="Shuffle Playlist"/>
                    <Button x:Name="BtnWhisper" Style="{StaticResource TextToggleButton}" Content="CC+" Click="BtnWhisper_Click" Margin="4,0,8,0" ToolTip="Auto Generate Subtitle (Whisper)" Height="20" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5" CornerRadius="4" Padding="6,0" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                    <Trigger Property="Tag" Value="On">
                                        <Setter Property="Foreground" Value="#00E5FF"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="TxtWhisperProgress" Text="" Foreground="#00E5FF" FontSize="11" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource KnobButton}" ToolTip="Previous" Click="BtnPrev_Click" Margin="0,0,6,0">
                        <Path Data="{StaticResource PrevIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource KnobButton}" ToolTip="Rewind 10s (←)" Click="BtnSkipBack_Click" Margin="0,0,6,0">
                        <Path Data="{StaticResource RewindIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnPlayPause" Style="{StaticResource KnobButton}" Width="44" Height="44" ToolTip="Play/Pause (Space)" Click="BtnPlayPause_Click" Margin="0,0,6,0">
                        <Path x:Name="PlayPauseIconPath" Data="{StaticResource PlayIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource KnobButton}" ToolTip="Stop" Click="BtnStop_Click" Margin="0,0,6,0">
                        <Path Data="{StaticResource StopIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource KnobButton}" ToolTip="Forward 10s (→)" Click="BtnSkipForward_Click" Margin="0,0,6,0">
                        <Path Data="{StaticResource ForwardIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource KnobButton}" ToolTip="Next" Click="BtnNext_Click">
                        <Path Data="{StaticResource NextIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnMute" Style="{StaticResource KnobButton}" ToolTip="Mute/Unmute (M)" Click="BtnMute_Click" Margin="0,0,5,0">
                        <Path x:Name="MuteIconPath" Data="{StaticResource VolumeHighIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Slider x:Name="SliderVolume" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True" ValueChanged="SliderVolume_ValueChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Border Width="1" Height="20" Background="{DynamicResource DividerBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="Speed" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnSpeed" Style="{StaticResource SpeedTextButton}" Content="1.0x ▾" ToolTip="Playback Speed" Click="BtnSpeed_Click" Margin="0,0,12,0">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuSpeed">
                                <MenuItem Header="0.25x" Tag="0.25" Click="MenuItemSpeed_Click"/>
                                <MenuItem Header="0.5x"  Tag="0.5"  Click="MenuItemSpeed_Click"/>
                                <MenuItem Header="0.75x" Tag="0.75" Click="MenuItemSpeed_Click"/>
                                <MenuItem Header="1.0x"  Tag="1.0"  Click="MenuItemSpeed_Click"/>
                                <MenuItem Header="1.25x" Tag="1.25" Click="MenuItemSpeed_Click"/>
                                <MenuItem Header="1.5x"  Tag="1.5"  Click="MenuItemSpeed_Click"/>
                                <MenuItem Header="2.0x"  Tag="2.0"  Click="MenuItemSpeed_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnTheme" Style="{StaticResource KnobButton}" ToolTip="Toggle Theme" Click="BtnTheme_Click" Margin="0,0,5,0">
                        <Path x:Name="ThemeIconPath" Data="{StaticResource MoonIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource KnobButton}" ToolTip="Fullscreen (F11)" Click="BtnFullscreen_Click">
                        <Path Data="{StaticResource FullscreenIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>