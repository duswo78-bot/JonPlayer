<Window x:Class="JonPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JonPlayer"
        Title="JonPlayer"
        Width="1100" Height="700"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="MainWindow_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- SVG Vector Icon Geometries -->
        <Geometry x:Key="PlayIcon">M 8,5 L 20,12 L 8,19 Z</Geometry>
        <Geometry x:Key="PauseIcon">M 6,5 H 10 V 19 H 6 Z M 14,5 H 18 V 19 H 14 Z</Geometry>
        <Geometry x:Key="StopIcon">M 6,6 H 18 V 18 H 6 Z</Geometry>
        <Geometry x:Key="RewindIcon">M 20,5 L 11,12 L 20,19 Z M 11,5 L 2,12 L 11,19 Z</Geometry>
        <Geometry x:Key="ForwardIcon">M 4,5 L 13,12 L 4,19 Z M 13,5 L 22,12 L 13,19 Z</Geometry>
        <Geometry x:Key="PrevIcon">M 16,5 L 7,12 L 16,19 Z M 5,5 H 7 V 19 H 5 Z</Geometry>
        <Geometry x:Key="NextIcon">M 8,5 L 17,12 L 8,19 Z M 17,5 H 19 V 19 H 17 Z</Geometry>
        <Geometry x:Key="OpenIcon">M 2,18 V 20 C 2,21.1 2.9,22 4,22 H 20 C 21.1,22 22,21.1 22,20 V 18 M 12,2 L 19,9 H 14 V 16 H 10 V 9 H 5 Z</Geometry>
        <Geometry x:Key="MuteIcon">M 19,12 L 22,9 L 20.6,7.6 L 17.6,10.6 L 14.6,7.6 L 13.2,9 L 16.2,12 L 13.2,15 L 14.6,16.4 L 17.6,13.4 L 20.6,16.4 L 22,15 Z M 3,9 V 15 H 7 L 12,20 V 4 L 7,9 Z</Geometry>
        <Geometry x:Key="VolumeLowIcon">M 3,9 V 15 H 7 L 12,20 V 4 L 7,9 H 3 Z M 16.5,12 C 16.5,10.2 15.5,8.7 14,8 V 16 C 15.5,15.3 16.5,13.8 16.5,12 Z</Geometry>
        <Geometry x:Key="VolumeHighIcon">M 3,9 V 15 H 7 L 12,20 V 4 L 7,9 H 3 Z M 16.5,12 C 16.5,10.2 15.5,8.7 14,8 V 16 C 15.5,15.3 16.5,13.8 16.5,12 Z M 14,3.2 V 5.3 C 16.9,6.1 19,8.8 19,12 C 19,15.2 16.9,17.9 14,18.7 V 20.8 C 18,19.9 21,16.3 21,12 C 21,7.7 18,4.1 14,3.2 Z</Geometry>
        <Geometry x:Key="SunIcon">M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,2L14.39,5.42C13.65,5.15 12.84,5 12,5C11.16,5 10.35,5.15 9.61,5.42L12,2M3.34,7L7.5,6.65C6.9,7.16 6.36,7.78 5.94,8.5C5.5,9.24 5.25,10 5.11,10.79L3.34,7M3.36,17L5.12,13.23C5.26,14 5.53,14.78 5.95,15.5C6.37,16.24 6.91,16.86 7.5,17.37L3.36,17M20.65,7L18.88,10.79C18.74,10 18.47,9.23 18.05,8.5C17.63,7.78 17.1,7.15 16.5,6.64L20.65,7M20.64,17L16.5,17.36C17.09,16.85 17.62,16.22 18.04,15.5C18.46,14.77 18.73,14 18.87,13.22L20.64,17M12,22L9.61,18.56C10.36,18.83 11.16,19 12,19C12.84,19 13.65,18.83 14.39,18.56L12,22Z</Geometry>
        <Geometry x:Key="MoonIcon">M 12,3 C 11.2,3 10.5,3.1 9.7,3.3 C 12.8,5.4 14.8,9 14.8,13 C 14.8,17 12.8,20.6 9.7,22.7 C 10.5,22.9 11.2,23 12,23 C 17.5,23 22,18.5 22,13 C 22,7.5 17.5,3 12,3 Z</Geometry>
        <Geometry x:Key="FullscreenIcon">M 7,14 H 5 V 19 H 10 V 17 H 7 Z M 5,10 H 7 V 7 H 10 V 5 H 5 Z M 17,17 H 14 V 19 H 19 V 14 H 17 Z M 14,5 V 7 H 17 V 10 H 19 V 5 Z</Geometry>
        <Geometry x:Key="ExitFullscreenIcon">M 5,16 H 8 V 19 H 10 V 14 H 5 Z M 8,8 H 5 V 10 H 10 V 5 H 8 Z M 16,14 H 19 V 16 H 14 V 19 H 16 Z M 19,8 H 16 V 5 H 14 V 10 H 19 Z</Geometry>
        <Geometry x:Key="PlaylistIcon">M 3,6 H 15 V 8 H 3 Z M 3,11 H 15 V 13 H 3 Z M 3,16 H 11 V 18 H 3 Z M 15,16 V 21 L 20,18.5 Z</Geometry>

        <SolidColorBrush x:Key="BgBrush"        Color="#111111"/>
        <SolidColorBrush x:Key="PanelBrush"     Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
        <SolidColorBrush x:Key="AccentBrush"    Color="#1DB954"/>
        <SolidColorBrush x:Key="HoverBrush"     Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ActiveBrush"    Color="#383838"/>
        <SolidColorBrush x:Key="DividerBrush"   Color="#2C2C2C"/>
        <LinearGradientBrush x:Key="KnobBgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4E4E52" Offset="0.0"/>
            <GradientStop Color="#242426" Offset="0.4"/>
            <GradientStop Color="#5E5E62" Offset="0.8"/>
            <GradientStop Color="#2C2C2F" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="3"/>
            <Setter Property="MinWidth" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" Width="3" HorizontalAlignment="Right">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Width="3">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Arrow" Width="3">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" CornerRadius="1.5" Width="3"
                                                        Background="#66FFFFFF" Margin="0">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ColorAnimation Storyboard.TargetName="ThumbBd"
                                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                    To="#AAFFFFFF" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextBrush}"/>
            <Setter Property="Width"        Value="46"/>
            <Setter Property="Height"       Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Focusable"    Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C50F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KnobButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="Width"           Value="38"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="OuterRing" Fill="{DynamicResource DividerBrush}"/>
                            <Ellipse x:Name="KnobSurface" Fill="{DynamicResource KnobBgBrush}" Margin="1"/>
                            <Ellipse Margin="1" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.35,0.3" RadiusX="0.7" RadiusY="0.7">
                                        <GradientStop Color="#30FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="1" ShadowDepth="1" Color="Black" Direction="270" Opacity="0.5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KnobSurface" Property="Margin" Value="2"/>
                                <Setter TargetName="cp" Property="Margin" Value="1,1,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsKnobButton" TargetType="Button" BasedOn="{StaticResource KnobButton}">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="TimelineSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Rectangle Fill="Transparent" Height="20"/>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E5FF" Offset="0.0"/>
                                        <GradientStop Color="#7B2CBF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:SliderFillConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#FFFFFF" Stroke="#222222" StrokeThickness="1">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsTimelineSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Rectangle Fill="Transparent" Height="20"/>
                            <Border Height="4" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Center"/>
                            <Border Height="4" CornerRadius="2" Background="#1DB954" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:SliderFillConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="#1DB954" Stroke="#111111" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width"  Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Rectangle Fill="Transparent" Height="45"/>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center"/>
                            <Border Height="4" CornerRadius="2" Background="#007AFF" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:SliderFillConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10" Fill="#007AFF" Stroke="{DynamicResource BgBrush}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FsVolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width"  Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Rectangle Fill="Transparent" Height="45"/>
                            <Border Height="4" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Center"/>
                            <Border Height="4" CornerRadius="2" Background="#1DB954" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:SliderFillConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="10" Height="10" Fill="#1DB954" Stroke="#111111" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpeedTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1DB954"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Focusable"  Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="On">
                                <Setter Property="Foreground" Value="{DynamicResource ToggleOnBrush}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ToggleOnGlowColor}" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background"      Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="2">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding"    Value="18,7"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="RowTitleBar" Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="RowTimeline" Height="Auto"/>
            <RowDefinition x:Name="RowControls" Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="Assets/logo.png" Height="26" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"><Run Text="Jon" Foreground="{DynamicResource TextBrush}"/><Run Text="Player">
                            <Run.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00E5FF" Offset="0"/>
                                    <GradientStop Color="#0066FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Run.Foreground>
                        </Run></TextBlock>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,1,0,0">
                        <TextBlock Text="●" Foreground="#FF4500" FontSize="5" VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="A P T I V" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" FontFamily="Montserrat" VerticalAlignment="Center"/>
                        <TextBlock Text="●" Foreground="#FF4500" FontSize="5" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="TxtNowPlaying" Grid.Column="1" Text="Pick Your Vibe" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Content="⚊" ToolTip="Minimize" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButton}" Content="⬜" ToolTip="Maximize" Click="BtnMaximize_Click"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="✕" ToolTip="Close" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="VideoGrid" Grid.Row="1" Background="Black">
            <!-- Viewbox corrects aspect ratio when video is rotated 90°/270° -->
            <Viewbox x:Name="VideoViewbox" Stretch="Uniform" Visibility="Collapsed">
                <Image x:Name="VideoElement" Stretch="Uniform">
                    <Image.LayoutTransform>
                        <RotateTransform x:Name="VideoRotation" Angle="0"/>
                    </Image.LayoutTransform>
                </Image>
            </Viewbox>
            <Image x:Name="ImgSplash" Stretch="None" Source="Assets/BG logo.png" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Grid x:Name="AudioUI" Visibility="Collapsed">
                <Image x:Name="AudioCoverBackground" Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect Radius="50" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <Rectangle Fill="#88000000"/> 
                <Canvas x:Name="AudioNotesCanvas" IsHitTestVisible="False"/>
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border CornerRadius="12" Margin="0,0,0,30" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle Fill="#22FFFFFF" RadiusX="12" RadiusY="12"/>
                            <Image x:Name="AudioCoverForeground" Width="250" Height="250" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,250,250" RadiusX="12" RadiusY="12"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    
                    <TextBlock x:Name="TxtAudioTitle" Grid.Row="1" Text="" Foreground="White" FontSize="28" FontWeight="Bold" FontFamily="Montserrat" HorizontalAlignment="Center" Margin="0,0,0,5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600"/>
                    <TextBlock x:Name="TxtAudioArtist" Grid.Row="2" Text="" Foreground="#DDDDDD" FontSize="18" FontWeight="Medium" FontFamily="Montserrat" HorizontalAlignment="Center" Margin="0,0,0,5" MaxWidth="600" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtAudioAlbum" Grid.Row="3" Text="" Foreground="#AAAAAA" FontSize="14" FontFamily="Montserrat" HorizontalAlignment="Center" MaxWidth="600" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>

            <Rectangle x:Name="MouseLayer" Fill="Transparent" IsHitTestVisible="True" MouseLeftButtonDown="MouseLayer_MouseLeftButtonDown"/>

            <!-- Subtitle UI -->
            <Border x:Name="SubtitleBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,80" Background="#A0000000" CornerRadius="8" Padding="16,8" IsHitTestVisible="True" Panel.ZIndex="50" Visibility="Collapsed" MouseLeftButtonDown="SubtitleBorder_MouseLeftButtonDown" MouseLeftButtonUp="SubtitleBorder_MouseLeftButtonUp" MouseMove="SubtitleBorder_MouseMove" Cursor="SizeAll">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="SubtitleTransform" X="0" Y="0"/>
                        <TranslateTransform x:Name="FsSubtitleShift" X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <TextBlock x:Name="TxtSubtitle" Foreground="White" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1000">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.8" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Loading Overlay for Whisper -->
            <Border x:Name="WhisperLoadingOverlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#90000000" Visibility="Collapsed" Panel.ZIndex="200" IsHitTestVisible="True">
                <StackPanel x:Name="WhisperLoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="WhisperLoadingScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="WhisperLoadingTranslate" X="0" Y="0" />
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <!-- JonPlayer Logo -->
                    <Image Source="Assets/logo.png" Stretch="Uniform" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image.RenderTransform>
                            <RotateTransform x:Name="WhisperSpinner" Angle="0" CenterX="24" CenterY="24"/>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock x:Name="TxtWhisperStatus" Text="Extracting Audio..." Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ProgressBar x:Name="ProgWhisper" Width="300" Height="6" Maximum="100" Value="0" Foreground="#00E5FF" Background="#444" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <Border x:Name="OverlayStats" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="10" Background="#CC000000" CornerRadius="5" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="100">
                <TextBlock x:Name="TxtOverlayStats" Foreground="#00FF00" FontFamily="Consolas" FontSize="12" LineHeight="18" Text="Stats..." />
            </Border>

            <!-- Toast UI for Notifications -->
            <Border x:Name="ToastOverlay" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0" Padding="16,10" Background="#CC111111" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="150" BorderBrush="#55FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <TextBlock x:Name="TxtToast" Foreground="White" FontSize="14" FontWeight="SemiBold" Text="Notification"/>
            </Border>

            <!-- Fullscreen Close Button -->
            <Button x:Name="BtnFsCloseVideo" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,30,0" Width="40" Height="40" Click="BtnFsCloseVideo_Click" Visibility="Collapsed" Panel.ZIndex="100" Cursor="Hand" ToolTip="Close App">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="20">
                            <Path Data="M 12 12 L 28 28 M 28 12 L 12 28" Stroke="White" StrokeThickness="3" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Opacity="0" x:Name="icon"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#44000000"/>
                                <Setter TargetName="icon" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Fullscreen Glassmorphism Volume Bar -->
            <Border x:Name="OverlayFsVolume" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0" Width="44" Height="220" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="22" Opacity="0.55" Visibility="Collapsed" Panel.ZIndex="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Path x:Name="IconFsVolume" Data="{StaticResource VolumeHighIcon}" Fill="{DynamicResource TextBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,16,0,0" Grid.Row="0"/>
                    <Border x:Name="FsVolumeTrack" Grid.Row="1" Margin="18,10,18,10" Background="#33FFFFFF" CornerRadius="2">
                        <Border x:Name="FsVolumeFill" VerticalAlignment="Bottom" Background="#1DB954" Height="0" CornerRadius="2"/>
                    </Border>
                    <TextBlock x:Name="TxtFsVolume" Text="50" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16" Grid.Row="2"/>
                </Grid>
            </Border>

            <!-- Glassmorphism Playlist Popup (draggable) -->
            <Border x:Name="PlaylistOverlay"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="10,10,10,200"
                    Width="300" MaxHeight="420"
                    Visibility="Collapsed"
                    Panel.ZIndex="100"
                    MouseEnter="PlaylistOverlay_MouseEnter"
                    MouseLeave="PlaylistOverlay_MouseLeave"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PlaylistTranslate" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55"/>
                </Border.Effect>
                <!-- Outer glass border -->
                <Border CornerRadius="14"
                        BorderBrush="{DynamicResource PlaylistBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Background>
                        <SolidColorBrush Color="Transparent" />
                    </Border.Background>
                    <Grid Background="{DynamicResource PlaylistBgBrush}">
                        <!-- Subtle top gloss highlight -->
                        <Border CornerRadius="14,14,0,0" Height="50" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>
                            <Border Background="{DynamicResource PlaylistTopGlossBrush}"/>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Drag handle / title bar -->
                            <Border Grid.Row="0" CornerRadius="14,14,0,0"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="PlaylistOverlay_DragStart"
                                    MouseMove="PlaylistOverlay_DragMove"
                                    MouseLeftButtonUp="PlaylistOverlay_DragEnd"
                                    Padding="12,10,10,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#221DB954" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Drag grip dots -->
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,2"/>
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,2"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,0"/>
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Playlist" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <Border Background="#331DB954" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtPlaylistCount" Text="0" Foreground="#1DB954" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Width="26" Height="26" Margin="0,0,4,0" ToolTip="Add Files" Click="BtnPlaylistAdd_Click" Cursor="Hand" Focusable="False"
                                                Background="#28FFFFFF" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#441DB954"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="+" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button Width="26" Height="26" ToolTip="Close Playlist" Click="BtnPlaylistClose_Click" Cursor="Hand" Focusable="False"
                                                Background="#28FFFFFF" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#44FF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="✕" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Thin divider -->
                            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Playlist Items -->
                            <ListBox x:Name="ListPlaylist" Grid.Row="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextBrush}" Margin="4,4,4,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="ListPlaylist_MouseDoubleClick"
                                     PreviewKeyDown="ListPlaylist_PreviewKeyDown">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                                </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Now playing indicator bar -->
                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                                    Margin="0,3,6,3" VerticalAlignment="Stretch"
                                                    Background="{Binding IsCurrentlyPlaying, Converter={x:Static local:BoolToAccentBrushConverter.Instance}}"/>
                                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           FontSize="12" Padding="0,4,4,4" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Button Content="▲" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" BorderThickness="0" Padding="3,1" Cursor="Hand" Click="BtnMoveUp_Click" Focusable="False"/>
                                                <Button Content="▼" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" BorderThickness="0" Padding="3,1" Cursor="Hand" Click="BtnMoveDown_Click" Focusable="False"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,1" Margin="2,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#221DB954"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- Glassmorphism Shortcuts Overlay (draggable) -->
            <Border x:Name="ShortcutsOverlay"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="630" Height="630"
                    Visibility="Collapsed"
                    Panel.ZIndex="100"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ShortcutsTranslate" X="0" Y="0"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55"/>
                </Border.Effect>
                <!-- Outer glass border -->
                <Border CornerRadius="14"
                        BorderBrush="{DynamicResource PlaylistBorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Border.Background>
                        <SolidColorBrush Color="Transparent" />
                    </Border.Background>
                    <Grid Background="{DynamicResource PlaylistBgBrush}">
                        <!-- Subtle top gloss highlight -->
                        <Border CornerRadius="14,14,0,0" Height="50" VerticalAlignment="Top" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent" />
                            </Border.Background>
                            <Border Background="{DynamicResource PlaylistTopGlossBrush}"/>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Drag handle / title bar -->
                            <Border Grid.Row="0" CornerRadius="14,14,0,0"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="ShortcutsOverlay_DragStart"
                                    MouseMove="ShortcutsOverlay_DragMove"
                                    MouseLeftButtonUp="ShortcutsOverlay_DragEnd"
                                    Padding="12,10,10,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#221DB954" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Drag grip dots -->
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,2"/>
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,2"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,0"/>
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,2,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Keyboard Shortcuts" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Width="26" Height="26" ToolTip="Close Shortcuts" Click="BtnShortcutsClose_Click" Cursor="Hand" Focusable="False"
                                                Background="#28FFFFFF" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="13">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#44FF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock Text="✕" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Thin divider -->
                            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Shortcuts List -->
                            <ScrollViewer Grid.Row="1" Margin="10,10,10,10" VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                                </ScrollViewer.Resources>
                                <StackPanel Orientation="Vertical">
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="F1" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="단축키 안내 보기/숨기기 (Show / Hide Shortcuts)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center"><TextBlock Text="Space" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        <TextBlock Grid.Column="1" Text="재생 / 일시정지 (Play / Pause)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2" Margin="0,0,2,0"><TextBlock Text="F11" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                            <Border Background="#22FFFFFF" CornerRadius="4" Padding="4,2"><TextBlock Text="Enter" Foreground="#1DB954" FontWeight="Bold"/></Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="전체화면 전환 (Toggle Fullscreen)" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
